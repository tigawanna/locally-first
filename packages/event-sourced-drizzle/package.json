{
  "name": "event-sourced-drizzle",
  "version": "0.0.1",
  "description": "Event-sourced local-first sync engine for Drizzle ORM with extensible inbox/outbox tables (SQLite + PGlite/Postgres)",
  "keywords": [
    "drizzle",
    "event-sourcing",
    "local-first",
    "offline",
    "offline-first",
    "pglite",
    "postgres",
    "sqlite",
    "sync"
  ],
  "bugs": {
    "url": "https://github.com/tigawanna/locally-first/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tigawanna/locally-first.git"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./pg": "./dist/pg.mjs",
    "./react": "./dist/react.mjs",
    "./sqlite": "./dist/sqlite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "example:sqlite": "tsx examples/sqlite.ts",
    "example:pglite": "tsx examples/pglite.ts",
    "example:generate:sqlite": "drizzle-kit generate --config examples/drizzle.sqlite.config.ts",
    "example:generate:pglite": "drizzle-kit generate --config examples/drizzle.pglite.config.ts",
    "check-types": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build",
    "check-exports": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "postbuild": "npm run check-exports"
  },
  "dependencies": {
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@electric-sql/pglite": "^0.5.5",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "inlinedDependencies": {
    "better-sqlite3": "13.0.3"
  }
}
