{
  "name": "locally-first",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:packages": "pnpm --filter event-sourced-collection --filter event-sourced-drizzle --parallel test",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt .",
    "format:fix": "vp fmt .",
    "check-types": "turbo run check-types",
    "quality": "turbo run //#lint //#format",
    "quality:fix": "turbo run //#lint:fix //#format:fix",
    "prepare": "vp config",
    "publish:event-sourced": "pnpm --filter event-sourced-collection publish --access public",
    "pack:event-sourced": "pnpm --filter event-sourced-collection exec npm pack --dry-run",
    "publish:drizzle-sync": "pnpm --filter event-sourced-drizzle publish --access public",
    "pack:drizzle-sync": "pnpm --filter event-sourced-drizzle exec npm pack --dry-run"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.27.0"
}
